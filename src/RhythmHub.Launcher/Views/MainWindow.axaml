<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RhythmHub.Launcher.ViewModels"
        xmlns:services="using:RhythmHub.Launcher.Services"
        xmlns:l="using:RhythmHub.Launcher.Views"
        x:Class="RhythmHub.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RhythmHub"
        Icon="/Assets/RhythmHub.ico"
        Width="1100" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource LabelBrush}"
        FontSize="14">
  <Grid ColumnDefinitions="260,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,0,12,16">
        <!-- Room for the macOS traffic lights when the content extends into the title bar. -->
        <Panel x:Name="TitleBarSpacer" DockPanel.Dock="Top" Height="16" />
        <TextBlock DockPanel.Dock="Top" Text="{l:Tr Sidebar_Games}" Classes="secondary" FontSize="11" FontWeight="SemiBold"
                   Margin="10,0,10,6" />

        <DockPanel DockPanel.Dock="Bottom" Margin="10,10,10,0">
          <Button DockPanel.Dock="Right" Classes="link" Content="{l:Tr Logs}" FontSize="12"
                  Command="{Binding OpenLogsCommand}" />
          <TextBlock Text="{Binding LauncherVersionText}" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,0" Spacing="4">
          <DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource TranslateIcon}" Width="16" Height="16"
                        Foreground="{DynamicResource SecondaryLabelBrush}" />
              <TextBlock Text="{l:Tr Language}" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox HorizontalAlignment="Right" FontSize="12" MinHeight="28" Padding="10,2"
                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="services:LanguageOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasLauncherUpdate}"
                Background="{DynamicResource FloatingCardBrush}" CornerRadius="12" Padding="12"
                BoxShadow="0 1 2 0 #10000000">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="{Binding LauncherUpdateTitle}" />
            <TextBlock Text="{Binding LauncherUpdateText}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
            <Button Classes="pill primary small" Content="{l:Tr Launcher_RestartToUpdate}" Margin="0,2,0,0"
                    Command="{Binding RestartToUpdateCommand}" />
          </StackPanel>
        </Border>

        <ListBox Classes="sidebar" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GameViewModel">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="36" Height="36" CornerRadius="9" ClipToBounds="True">
                  <Panel>
                    <Border Background="{Binding Accent}" IsVisible="{Binding !HasIcon}">
                      <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SidebarText}" Classes="secondary" FontSize="12" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Selected game -->
    <ScrollViewer Grid.Column="1">
      <ContentControl Content="{Binding SelectedGame}" Margin="48,44,48,32" MaxWidth="760" HorizontalAlignment="Left">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:GameViewModel">
            <StackPanel Spacing="28">

              <!-- Header: tile, name, actions -->
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="152" Height="152" CornerRadius="34" Background="{DynamicResource WindowBrush}"
                        BoxShadow="0 12 32 0 #24000000">
                  <Border CornerRadius="34" ClipToBounds="True">
                    <Panel>
                      <Border Background="{Binding Accent}" IsVisible="{Binding !HasIcon}">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="76" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                    </Panel>
                  </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Bottom" Spacing="6">
                  <TextBlock Text="{Binding DisplayName}" FontSize="38" FontWeight="Bold" LetterSpacing="-0.8" />
                  <TextBlock Text="{Binding Description}" Classes="secondary" FontSize="17" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,14,0,0" ItemSpacing="12" LineSpacing="12">
                    <Button Classes="pill primary" Content="{Binding PrimaryText}" MinWidth="140"
                            Command="{Binding PrimaryCommand}" />
                    <Button Classes="pill" Content="{l:Tr Action_Cancel}" IsVisible="{Binding IsBusy}"
                            Command="{Binding CancelCommand}" />
                    <Button Classes="pill" Content="{l:Tr Action_CheckForUpdates}" IsVisible="{Binding ShowCheckButton}"
                            Command="{Binding CheckCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Grid>

              <!-- Status line -->
              <TextBlock Text="{Binding StatusText}" IsVisible="{Binding ShowStatus}" FontSize="13"
                         Classes="secondary" Classes.error="{Binding IsFailed}" TextWrapping="Wrap">
                <TextBlock.Styles>
                  <Style Selector="TextBlock.error">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                  </Style>
                </TextBlock.Styles>
              </TextBlock>

              <!-- Progress card -->
              <Border IsVisible="{Binding ShowProgress}" Background="{DynamicResource CardBrush}"
                      CornerRadius="14" Padding="22,20">
                <StackPanel Spacing="14">
                  <TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <ProgressBar Classes="thin" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                               IsIndeterminate="{Binding IsProgressIndeterminate}" />
                  <TextBlock Text="{Binding ProgressText}" Classes="secondary" FontSize="13" />
                </StackPanel>
              </Border>

              <!-- Details, grouped like system settings -->
              <Border Background="{DynamicResource CardBrush}" CornerRadius="14" ClipToBounds="True">
                <StackPanel>
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:Tr Label_Channel}" FontWeight="Medium" VerticalAlignment="Center" />
                    <ListBox Grid.Column="1" Classes="segmented" Margin="0,8"
                             ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                             IsEnabled="{Binding CanChangeChannel}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:ChannelOption">
                          <TextBlock Text="{Binding ShortLabel}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>

                  <Border Classes="separator" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:Tr Label_InstalledVersion}" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding InstalledVersionShort}" Classes="secondary"
                               VerticalAlignment="Center" />
                  </Grid>

                  <StackPanel IsVisible="{Binding RemoteVersion, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border Classes="separator" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{l:Tr Label_LatestVersion}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding RemoteVersion}" Classes="secondary"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding CanRollback}">
                    <Border Classes="separator" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Text="{l:Tr Label_PreviousVersion}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding PreviousVersion}" Classes="secondary"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="link" Content="{l:Tr Action_Restore}" Margin="14,0,0,0"
                              VerticalAlignment="Center" Command="{Binding RollbackCommand}" />
                    </Grid>
                  </StackPanel>

                  <Border Classes="separator" />
                  <Grid Classes="row" ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Text="{l:Tr Label_Location}" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding GameFolderText}" Classes="secondary"
                               TextTrimming="PathSegmentEllipsis" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                    <Button Grid.Column="2" Classes="link" Content="{l:Tr Action_ChangeFolder}" Margin="14,0,0,0"
                            VerticalAlignment="Center" ToolTip.Tip="{l:Tr ChangeFolder_Tip}"
                            IsEnabled="{Binding CanChangeFolder}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeGameFolderCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Classes="link" Content="{Binding RevealFolderText}" Margin="14,0,0,0"
                            VerticalAlignment="Center" IsVisible="{Binding HasInstall}"
                            Command="{Binding OpenGameFolderCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </ScrollViewer>
  </Grid>
</Window>
